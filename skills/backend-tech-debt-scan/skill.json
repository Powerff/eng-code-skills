{
  "name": "backend-tech-debt-scan",
  "displayName": "后端技术债务扫描",
  "version": "0.1.0",
  "category": "backend",
  "description": "后端技术债务扫描：事务债、数据访问债、并发债、配置与安全债，输出可排期清单。Use when backend tech debt, 后端债务, 服务端扫描。",
  "license": "MIT",
  "compatibility": [
    "agentskills.io",
    "Cursor",
    "Claude Code",
    "ChatGPT",
    "GitHub Copilot",
    "Gemini",
    "Continue",
    "Cline",
    "Roo Code",
    "Windsurf",
    "Trae",
    "manual-prompt"
  ],
  "tags": [
    "backend",
    "tech-debt",
    "scan"
  ],
  "focus": [
    "transaction-debt",
    "data-access",
    "concurrency",
    "security-config"
  ],
  "entrypoint": "SKILL.md",
  "files": [
    "SKILL.md",
    "prompt.md",
    "skill.json",
    "examples/"
  ],
  "inputSchema": {
    "type": "object",
    "properties": {
      "target": {
        "type": "string",
        "description": "目标文件、目录或代码片段"
      },
      "language": {
        "type": "string",
        "description": "可选：主要编程语言"
      },
      "constraints": {
        "type": "string",
        "description": "可选：额外约束（如只改某一模块）"
      }
    },
    "required": [
      "target"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "summary": {
        "type": "string"
      },
      "diff": {
        "type": "string"
      },
      "code": {
        "type": "string"
      },
      "riskWarnings": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "manualChecks": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "summary",
      "diff",
      "riskWarnings",
      "manualChecks"
    ]
  },
  "modelFamilies": [
    "OpenAI GPT",
    "Anthropic Claude",
    "Google Gemini",
    "DeepSeek",
    "Qwen",
    "Moonshot Kimi",
    "xAI Grok",
    "other tool-using coding LLMs"
  ],
  "runtimeNotes": "Prompt-based and model-agnostic. Works with any mainstream coding LLM that can follow structured instructions. Prefer long-context, tool-using models for workflow skills (implement/verify, project refactor)."
}
