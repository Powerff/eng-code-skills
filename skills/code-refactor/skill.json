{
  "name": "code-refactor",
  "displayName": "通用安全重构",
  "version": "0.1.0",
  "category": "general",
  "description": "通用安全重构：拆分函数、消除重复、提升可读性，严禁改业务逻辑。Use when user asks to refactor safely, 安全重构, 不改业务逻辑重构。",
  "license": "MIT",
  "compatibility": [
    "agentskills.io",
    "Cursor",
    "Claude Code"
  ],
  "tags": [
    "refactor",
    "safe",
    "general"
  ],
  "focus": [
    "extract-method",
    "dedup",
    "readability",
    "structure"
  ],
  "entrypoint": "SKILL.md",
  "files": [
    "SKILL.md",
    "prompt.md",
    "skill.json",
    "examples/"
  ],
  "inputSchema": {
    "type": "object",
    "properties": {
      "target": {
        "type": "string",
        "description": "目标文件、目录或代码片段"
      },
      "language": {
        "type": "string",
        "description": "可选：主要编程语言"
      },
      "constraints": {
        "type": "string",
        "description": "可选：额外约束（如只改某一模块）"
      }
    },
    "required": [
      "target"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "summary": {
        "type": "string"
      },
      "diff": {
        "type": "string"
      },
      "code": {
        "type": "string"
      },
      "riskWarnings": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "manualChecks": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "summary",
      "diff",
      "riskWarnings",
      "manualChecks"
    ]
  }
}
