{
  "name": "greenfield-graph-loop-commit",
  "displayName": "Greenfield Graph+Loop 0-1（含提交推送）",
  "version": "0.1.0",
  "category": "greenfield-workflow",
  "description": "0-1 from requirements with full closure: Graph Engineering → multi-slice Loop → MVP → commit/push → stop. Use when greenfield commit, 0-1 提交, @greenfield-graph-loop-commit。",
  "license": "MIT",
  "compatibility": ["agentskills.io", "Cursor", "Claude Code", "ChatGPT", "GitHub Copilot", "Gemini", "Continue", "Cline", "Roo Code", "Windsurf", "Trae", "manual-prompt"],
  "tags": ["greenfield", "graph-engineering", "loop-engineering", "commit", "0-1"],
  "focus": ["requirements", "slices", "mvp", "commit", "push", "cleanup"],
  "kind": "workflow",
  "entrypoint": "SKILL.md",
  "source": "Adapted from implement-verify-commit + greenfield-graph-loop",
  "files": ["SKILL.md", "prompt.md", "skill.json", "examples/"],
  "inputSchema": {
    "type": "object",
    "properties": {
      "requirements": { "type": "string", "description": "PRD path or requirements text" },
      "stack": { "type": "string" },
      "skipPush": { "type": "boolean", "description": "If true, commit only" }
    },
    "required": ["requirements"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "summary": { "type": "string" },
      "commit": { "type": "string" },
      "riskWarnings": { "type": "array", "items": { "type": "string" } },
      "manualChecks": { "type": "array", "items": { "type": "string" } }
    },
    "required": ["summary", "riskWarnings", "manualChecks"]
  },
  "modelFamilies": ["OpenAI GPT", "Anthropic Claude", "Google Gemini", "DeepSeek", "Qwen", "Moonshot Kimi", "xAI Grok", "other tool-using coding LLMs"],
  "runtimeNotes": "Long-context tool-using model. Git write access needed for Phase C."
}
