{
  "name": "backend-stack-upgrade",
  "displayName": "后端技术栈升级（方案→编码→验证）",
  "version": "0.1.0",
  "category": "backend-workflow",
  "description": "后端技术栈升级完整闭环：图谱定向 → 升级方案 → 编码落地 → 功能验证 → 停服释放。典型 JDK 17→21；会改仓库但不自动 commit/push。Use when JDK upgrade, Java 21, stack upgrade, 架构升级, 运行时升级, toolchain, @backend-stack-upgrade。",
  "license": "MIT",
  "compatibility": [
    "agentskills.io",
    "Cursor",
    "Claude Code",
    "ChatGPT",
    "GitHub Copilot",
    "Gemini",
    "Continue",
    "Cline",
    "Roo Code",
    "Windsurf",
    "Trae",
    "manual-prompt"
  ],
  "tags": [
    "backend",
    "jdk",
    "upgrade",
    "migration",
    "toolchain",
    "workflow"
  ],
  "focus": [
    "inventory",
    "upgrade-plan",
    "toolchain",
    "implement",
    "verify",
    "cleanup"
  ],
  "kind": "workflow",
  "entrypoint": "SKILL.md",
  "files": [
    "SKILL.md",
    "prompt.md",
    "skill.json",
    "examples/"
  ],
  "inputSchema": {
    "type": "object",
    "properties": {
      "target": {
        "type": "string",
        "description": "仓库/模块路径，或升级描述（如 JDK 17→21）"
      },
      "fromVersion": {
        "type": "string",
        "description": "可选：当前版本，如 17"
      },
      "toVersion": {
        "type": "string",
        "description": "可选：目标版本，如 21"
      },
      "constraints": {
        "type": "string",
        "description": "可选：禁止改动的模块、必须保留的 JVM 参数等"
      }
    },
    "required": ["target"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "summary": { "type": "string" },
      "plan": { "type": "string" },
      "riskWarnings": {
        "type": "array",
        "items": { "type": "string" }
      },
      "manualChecks": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "required": ["summary", "riskWarnings", "manualChecks"]
  },
  "modelFamilies": [
    "OpenAI GPT",
    "Anthropic Claude",
    "Google Gemini",
    "DeepSeek",
    "Qwen",
    "Moonshot Kimi",
    "xAI Grok",
    "other tool-using coding LLMs"
  ],
  "runtimeNotes": "Prompt-based workflow. Prefer long-context, tool-using models that can edit build files and run Maven/Gradle. Does not auto-commit; pair with backend-code-commit when ready."
}
